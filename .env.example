# SPT version: tag from https://github.com/SP-Tushonka/build/releases (must match the client)
SPT_VERSION=4.1.3
# Fika server version: tag from https://github.com/project-fika/Fika-Server-CSharp/releases (empty = no Fika)
FIKA_VERSION=2.4.1
# Public address the launcher connects to (nginx on 443 proxies to SPT on 6969)
SPT_BACKEND_IP=your.public.ip
SPT_BACKEND_PORT=443
SPT_PORT=6969
TZ=Europe/Moscow
